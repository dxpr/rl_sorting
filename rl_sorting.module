<?php

/**
 * @file
 * Primary module file for RL Sorting.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\rl_sorting\Hook\RlSortingHooks;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function rl_sorting_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(RlSortingHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_views_pre_render().
 */
#[LegacyHook]
function rl_sorting_views_pre_render(ViewExecutable $view) {
  \Drupal::service(RlSortingHooks::class)->viewsPreRender($view);
}

/**
 * Implements hook_contextual_links_view_alter().
 */
#[LegacyHook]
function rl_sorting_contextual_links_view_alter(&$element, $items) {
  \Drupal::service(RlSortingHooks::class)->contextualLinksViewAlter($element, $items);
}

/**
 * Implements hook_views_data_alter().
 */
#[LegacyHook]
function rl_sorting_views_data_alter(array &$data) {
  \Drupal::service(RlSortingHooks::class)->viewsDataAlter($data);
}
